generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model EnvironmentIdentity {
  id            Int      @id
  environmentId String   @map("environment_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("environment_identity")
  @@schema("app")
}

model TransactionFixture {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  namespace String @db.Text
  code      String @db.Text

  @@unique([namespace, code])
  @@map("transaction_fixture")
  @@schema("app")
}
