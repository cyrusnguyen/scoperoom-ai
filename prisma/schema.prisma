generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model EnvironmentIdentity {
  id            Int      @id
  environmentId String   @map("environment_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("environment_identity")
  @@schema("app")
}

model TransactionFixture {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  namespace String @db.Text
  code      String @db.Text

  @@unique([namespace, code])
  @@map("transaction_fixture")
  @@schema("app")
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED

  @@map("workspace_status")
  @@schema("app")
}

enum WorkspaceMemberRole {
  OWNER
  MEMBER

  @@map("workspace_member_role")
  @@schema("app")
}

enum MutationScopeKind {
  USER
  WORKSPACE
  PROJECT

  @@map("mutation_scope_kind")
  @@schema("app")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETING

  @@map("project_status")
  @@schema("app")
}

enum ScopeDraftStatus {
  EDITABLE
  ARCHIVED

  @@map("scope_draft_status")
  @@schema("app")
}

enum ProjectMemberRole {
  EDITOR
  REVIEWER
  VIEWER

  @@map("project_member_role")
  @@schema("app")
}

model UserProfile {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId          String?               @unique @map("auth_user_id") @db.Uuid
  displayName         String                @map("display_name") @db.Text
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  entitlement         PilotEntitlement?
  ownedWorkspaces     Workspace[]           @relation("workspace_owner")
  memberships         WorkspaceMembership[]
  projectMemberships  ProjectMembership[]
  receipts            MutationReceipt[]
  drafts              ScopeDraft[]
  auditEvents         AuditEvent[]          @relation("audit_actor")
  invitationsSent     Invitation[]          @relation("invitation_inviter")
  invitationsAccepted Invitation[]          @relation("invitation_acceptor")

  @@map("user_profile")
  @@schema("app")
}

model PilotEntitlement {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId         String      @unique @map("profile_id") @db.Uuid
  maxWorkspaces     Int         @default(1) @map("max_workspaces")
  active            Boolean     @default(true)
  grantedByOperator String      @map("granted_by_operator") @db.Uuid
  grantedAt         DateTime    @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt         DateTime?   @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?   @map("revoked_at") @db.Timestamptz(6)
  profile           UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("pilot_entitlement")
  @@schema("app")
}

model Workspace {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String                @map("owner_id") @db.Uuid
  name        String                @db.Text
  status      WorkspaceStatus       @default(ACTIVE)
  version     Int                   @default(1)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner       UserProfile           @relation("workspace_owner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  memberships WorkspaceMembership[]
  projects    Project[]

  @@index([ownerId])
  @@map("workspace")
  @@schema("app")
}

model WorkspaceMembership {
  workspaceId String              @map("workspace_id") @db.Uuid
  profileId   String              @map("profile_id") @db.Uuid
  role        WorkspaceMemberRole @default(MEMBER)
  active      Boolean             @default(true)
  version     Int                 @default(1)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile     UserProfile         @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([workspaceId, profileId])
  @@index([profileId, active])
  @@map("workspace_membership")
  @@schema("app")
}

model MutationReceipt {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String            @map("actor_id") @db.Uuid
  scopeKind   MutationScopeKind @map("scope_kind")
  scopeId     String            @map("scope_id") @db.Uuid
  key         String            @db.Text
  operation   String            @db.Text
  requestHash String            @map("request_hash") @db.Char(64)
  result      Json
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  actor       UserProfile       @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([actorId, scopeKind, scopeId, key], map: "mutation_receipt_scope_key")
  @@index([expiresAt])
  @@map("mutation_receipt")
  @@schema("app")
}

model Project {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId       String              @map("workspace_id") @db.Uuid
  name              String              @db.Text
  status            ProjectStatus       @default(ACTIVE)
  version           Int                 @default(1)
  membershipVersion Int                 @default(1) @map("membership_version")
  currentDraftId    String?             @map("current_draft_id") @db.Uuid
  realtimeEpoch     String              @default(dbgenerated("gen_random_uuid()")) @map("realtime_epoch") @db.Uuid
  eventSequence     BigInt              @default(0) @map("event_sequence") @db.BigInt
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace         Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  drafts            ScopeDraft[]        @relation("project_drafts")
  currentDraft      ScopeDraft?         @relation("project_current_draft", fields: [id, currentDraftId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction)
  auditEvents       AuditEvent[]
  memberships       ProjectMembership[]
  invitations       Invitation[]

  @@unique([workspaceId, id])
  @@unique([id, currentDraftId])
  @@index([workspaceId, status, createdAt, id])
  @@map("project")
  @@schema("app")
}

model ProjectMembership {
  projectId String            @map("project_id") @db.Uuid
  profileId String            @map("profile_id") @db.Uuid
  role      ProjectMemberRole
  active    Boolean           @default(true)
  version   Int               @default(1)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile   UserProfile       @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([projectId, profileId])
  @@index([profileId, active, projectId])
  @@map("project_membership")
  @@schema("app")
}

model Invitation {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String            @map("project_id") @db.Uuid
  workspaceId   String            @map("workspace_id") @db.Uuid
  tokenHash     String            @unique @map("token_hash") @db.Char(64)
  verifiedEmail String            @map("verified_email") @db.Text
  role          ProjectMemberRole
  version       Int               @default(1)
  invitedBy     String            @map("invited_by") @db.Uuid
  expiresAt     DateTime          @map("expires_at") @db.Timestamptz(6)
  acceptedBy    String?           @map("accepted_by") @db.Uuid
  acceptedAt    DateTime?         @map("accepted_at") @db.Timestamptz(6)
  revokedAt     DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  project       Project           @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction)
  inviter       UserProfile       @relation("invitation_inviter", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  acceptor      UserProfile?      @relation("invitation_acceptor", fields: [acceptedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([projectId, createdAt, id])
  @@index([expiresAt])
  @@map("invitation")
  @@schema("app")
}

model ScopeDraft {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  createdBy        String           @map("created_by") @db.Uuid
  documentRevision Int              @default(1) @map("document_revision")
  layoutRevision   Int              @default(1) @map("layout_revision")
  schemaVersion    Int              @default(3) @map("schema_version")
  documentJson     Json             @map("document_json")
  layoutJson       Json             @map("layout_json")
  status           ScopeDraftStatus @default(EDITABLE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project          Project          @relation("project_drafts", fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator          UserProfile      @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  currentFor       Project?         @relation("project_current_draft")

  @@unique([projectId, id])
  @@map("scope_draft")
  @@schema("app")
}

model AuditEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  workspaceId   String       @map("workspace_id") @db.Uuid
  sequence      BigInt       @db.BigInt
  actorId       String?      @map("actor_id") @db.Uuid
  serviceAction String?      @map("service_action") @db.Text
  action        String       @db.Text
  entityRefs    Json         @map("entity_refs")
  metadata      Json
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  project       Project      @relation(fields: [workspaceId, projectId], references: [workspaceId, id], onDelete: Cascade, onUpdate: NoAction)
  actor         UserProfile? @relation("audit_actor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([projectId, sequence])
  @@index([projectId, createdAt, id])
  @@map("audit_event")
  @@schema("app")
}
