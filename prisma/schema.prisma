generator client {
  provider            = "prisma-client"
  output              = "./generated"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
  schemas  = ["app"]
}

model EnvironmentIdentity {
  id            Int      @id
  environmentId String   @map("environment_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("environment_identity")
  @@schema("app")
}

model TransactionFixture {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  namespace String @db.Text
  code      String @db.Text

  @@unique([namespace, code])
  @@map("transaction_fixture")
  @@schema("app")
}

enum MutationScopeKind {
  USER
  PROJECT

  @@map("mutation_scope_kind")
  @@schema("app")
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
  DELETING

  @@map("project_status")
  @@schema("app")
}

enum ScopeDraftStatus {
  EDITABLE
  ARCHIVED

  @@map("scope_draft_status")
  @@schema("app")
}

enum FlowImportState {
  READY
  DISCARDED
  EXPIRED
  APPLIED

  @@map("flow_import_state")
  @@schema("app")
}

enum SourceKind {
  USER_TEXT
  USER_UPLOAD
  QUESTION_ANSWER
  AI_PROMPT
  PROMOTED_GRAPH

  @@map("source_kind")
  @@schema("app")
}

enum AiTaskKind {
  PROPOSE_FLOW
  REFINE_FLOW_SELECTION

  @@map("ai_task_kind")
  @@schema("app")
}

enum AiRunState {
  QUEUED
  RUNNING
  VALIDATING
  SUCCEEDED
  FAILED
  CANCELLED
  TIMED_OUT

  @@map("ai_run_state")
  @@schema("app")
}

enum AiResultDisposition {
  AVAILABLE
  APPLIED
  DISCARDED
  EXPIRED

  @@map("ai_result_disposition")
  @@schema("app")
}

enum AiDispatchState {
  PENDING
  DISPATCHED

  @@map("ai_dispatch_state")
  @@schema("app")
}

enum AiBudgetState {
  RESERVED
  CONSUMED
  RELEASED

  @@map("ai_budget_state")
  @@schema("app")
}

enum AiAttemptOutcome {
  COMPLETED
  REFUSED
  INCOMPLETE
  UNAVAILABLE
  UNKNOWN
  TIMED_OUT
  CANCELLED

  @@map("ai_attempt_outcome")
  @@schema("app")
}

enum ProjectMemberRole {
  EDITOR
  REVIEWER
  VIEWER

  @@map("project_member_role")
  @@schema("app")
}

model UserProfile {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authUserId            String?             @unique @map("auth_user_id") @db.Uuid
  displayName           String              @map("display_name") @db.Text
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  entitlement           PilotEntitlement?
  ownedProjects         Project[]           @relation("project_owner")
  projectMemberships    ProjectMembership[]
  receipts              MutationReceipt[]
  flowImportPreviews    FlowImportPreview[] @relation("flow_import_actor")
  drafts                ScopeDraft[]
  auditEvents           AuditEvent[]        @relation("audit_actor")
  invitationsSent       Invitation[]        @relation("invitation_inviter")
  invitationsAccepted   Invitation[]        @relation("invitation_acceptor")
  designatedApproverFor Project[]           @relation("project_designated_approver")
  sourceDocumentsCreated SourceDocument[]   @relation("source_document_creator")
  sourceVersionsCreated SourceVersion[]     @relation("source_version_creator")
  aiAllowance           AiOwnerAllowance?
  aiRunsStarted         AiRun[]             @relation("ai_run_actor")
  aiApplications        AiSuggestionApplication[]

  @@map("user_profile")
  @@schema("app")
}

model PilotEntitlement {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId         String      @unique @map("profile_id") @db.Uuid
  maxOwnedProjects  Int         @default(10) @map("max_owned_projects")
  active            Boolean     @default(true)
  grantedByOperator String      @map("granted_by_operator") @db.Uuid
  grantedAt         DateTime    @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt         DateTime?   @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime?   @map("revoked_at") @db.Timestamptz(6)
  profile           UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@map("pilot_entitlement")
  @@schema("app")
}

model MutationReceipt {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId     String            @map("actor_id") @db.Uuid
  scopeKind   MutationScopeKind @map("scope_kind")
  scopeId     String            @map("scope_id") @db.Uuid
  key         String            @db.Text
  operation   String            @db.Text
  requestHash String            @map("request_hash") @db.Char(64)
  result      Json
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime          @map("expires_at") @db.Timestamptz(6)
  actor       UserProfile       @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([actorId, scopeKind, scopeId, key], map: "mutation_receipt_scope_key")
  @@index([expiresAt])
  @@map("mutation_receipt")
  @@schema("app")
}

model Project {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId               String              @map("owner_id") @db.Uuid
  name                  String              @db.Text
  status                ProjectStatus       @default(ACTIVE)
  version               Int                 @default(1)
  settingsVersion       Int                 @default(1) @map("settings_version")
  approvalPolicyVersion Int                 @default(1) @map("approval_policy_version")
  membershipVersion     Int                 @default(1) @map("membership_version")
  designatedApproverId  String?             @map("designated_approver_id") @db.Uuid
  currentDraftId        String?             @map("current_draft_id") @db.Uuid
  realtimeEpoch         String              @default(dbgenerated("gen_random_uuid()")) @map("realtime_epoch") @db.Uuid
  eventSequence         BigInt              @default(0) @map("event_sequence") @db.BigInt
  aiRevision            BigInt              @default(0) @map("ai_revision") @db.BigInt
  sourcesRevision       BigInt              @default(0) @map("sources_revision") @db.BigInt
  requirementDisplaySequence Int            @default(0) @map("requirement_display_sequence")
  approvedSnapshotId    String?             @map("approved_snapshot_id") @db.Uuid
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner                 UserProfile         @relation("project_owner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  designatedApprover    UserProfile?        @relation("project_designated_approver", fields: [designatedApproverId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  drafts                ScopeDraft[]        @relation("project_drafts")
  currentDraft          ScopeDraft?         @relation("project_current_draft", fields: [id, currentDraftId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction, map: "project_current_draft_fkey")
  auditEvents           AuditEvent[]
  memberships           ProjectMembership[]
  invitations           Invitation[]
  flowImportPreviews    FlowImportPreview[] @relation("flow_import_project")
  sourceDocuments       SourceDocument[]
  aiRuns                AiRun[]
  aiApplications        AiSuggestionApplication[]

  @@unique([id, currentDraftId])
  @@index([ownerId, status, updatedAt, id])
  @@map("project")
  @@schema("app")
}

model ProjectMembership {
  projectId           String            @map("project_id") @db.Uuid
  profileId           String            @map("profile_id") @db.Uuid
  role                ProjectMemberRole
  active              Boolean           @default(true)
  version             Int               @default(1)
  deactivatedSequence BigInt?           @map("deactivated_sequence") @db.BigInt
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project             Project           @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profile             UserProfile       @relation(fields: [profileId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@id([projectId, profileId])
  @@index([profileId, active, projectId])
  @@map("project_membership")
  @@schema("app")
}

model Invitation {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String            @map("project_id") @db.Uuid
  tokenHash      String            @unique @map("token_hash") @db.Char(64)
  verifiedEmail  String            @map("verified_email") @db.Text
  role           ProjectMemberRole
  version        Int               @default(1)
  issuedSequence BigInt            @map("issued_sequence") @db.BigInt
  invitedBy      String            @map("invited_by") @db.Uuid
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)
  acceptedBy     String?           @map("accepted_by") @db.Uuid
  acceptedAt     DateTime?         @map("accepted_at") @db.Timestamptz(6)
  revokedAt      DateTime?         @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  inviter        UserProfile       @relation("invitation_inviter", fields: [invitedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  acceptor       UserProfile?      @relation("invitation_acceptor", fields: [acceptedBy], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([projectId, createdAt, id])
  @@index([verifiedEmail])
  @@index([expiresAt])
  @@map("invitation")
  @@schema("app")
}

model ScopeDraft {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  createdBy        String           @map("created_by") @db.Uuid
  documentRevision Int              @default(1) @map("document_revision")
  layoutRevision   Int              @default(1) @map("layout_revision")
  schemaVersion    Int              @default(3) @map("schema_version")
  documentJson     Json             @map("document_json")
  layoutJson       Json             @map("layout_json")
  status           ScopeDraftStatus @default(EDITABLE)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project          Project          @relation("project_drafts", fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator          UserProfile      @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  currentFor       Project?         @relation("project_current_draft")
  flowImportPreviews FlowImportPreview[] @relation("flow_import_draft")
  aiRuns           AiRun[]
  aiApplications   AiSuggestionApplication[]
  promotedSources  SourceVersion[]  @relation("source_version_origin_draft")

  @@unique([projectId, id])
  @@map("scope_draft")
  @@schema("app")
}

model FlowImportPreview {
  payloadHash              String          @map("payload_hash") @db.Char(64)
  formatVersion            Int             @default(1) @map("format_version")
  id                       String          @id @db.Uuid
  projectId                String          @map("project_id") @db.Uuid
  draftId                  String          @map("draft_id") @db.Uuid
  actorId                  String          @map("actor_id") @db.Uuid
  expectedDocumentRevision Int             @map("expected_document_revision")
  state                    FlowImportState @default(READY)
  payload                  Json?
  positions                Json?
  fidelityReport           Json?           @map("fidelity_report")
  previewHash              String          @map("preview_hash") @db.Char(64)
  expiresAt                DateTime        @map("expires_at") @db.Timestamptz(6)
  appliedAt                DateTime?       @map("applied_at") @db.Timestamptz(6)
  resultFlowId             String?         @map("result_flow_id") @db.Uuid
  appliedMapping           Json?           @map("applied_mapping")
  appliedResult            Json?           @map("applied_result")
  createdAt                DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  project                  Project         @relation("flow_import_project", fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  draft                    ScopeDraft      @relation("flow_import_draft", fields: [projectId, draftId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction)
  actor                    UserProfile     @relation("flow_import_actor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([expiresAt, id])
  @@index([projectId, actorId, id])
  @@index([actorId, createdAt], map: "flow_import_preview_actor_created_at_idx")
  @@map("flow_import_preview")
  @@schema("app")
}

model SourceDocument {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId         String          @map("project_id") @db.Uuid
  kind              SourceKind
  currentVersionId  String?         @map("current_version_id") @db.Uuid
  displayNickname   String?         @map("display_nickname") @db.Text
  archived          Boolean         @default(false)
  version           Int             @default(1)
  lastEventSequence BigInt          @default(0) @map("last_event_sequence") @db.BigInt
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator           UserProfile     @relation("source_document_creator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  currentVersion    SourceVersion?  @relation("source_document_head", fields: [projectId, id, currentVersionId], references: [projectId, sourceId, id], onDelete: NoAction, onUpdate: NoAction, map: "source_document_current_version_fkey")
  versions          SourceVersion[] @relation("source_document_versions")

  @@unique([projectId, id])
  @@map("source_document")
  @@schema("app")
}

model SourceVersion {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId      String           @map("project_id") @db.Uuid
  sourceId       String           @map("source_id") @db.Uuid
  sequence       Int
  title          String           @db.Text
  text           String           @db.Text
  codePointCount Int              @map("code_point_count")
  utf8ByteCount  Int              @map("utf8_byte_count")
  contentHash    String           @map("content_hash") @db.Char(64)
  createdBy      String           @map("created_by") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  origin         Json?
  originDraftId  String?          @map("origin_draft_id") @db.Uuid
  originDraft    ScopeDraft?      @relation("source_version_origin_draft", fields: [projectId, originDraftId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction, map: "source_version_origin_draft_fkey")
  source         SourceDocument   @relation("source_document_versions", fields: [projectId, sourceId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction, map: "source_version_source_fkey")
  creator        UserProfile      @relation("source_version_creator", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: NoAction)
  headOf         SourceDocument[] @relation("source_document_head")
  prompts        AiRun[]          @relation("ai_run_prompt_version")
  applicationPrompts AiSuggestionApplication[]
  applicationSources AiApplicationSource[]

  @@unique([sourceId, sequence])
  @@unique([projectId, sourceId, id])
  @@unique([projectId, id])
  @@map("source_version")
  @@schema("app")
}

model AiOwnerAllowance {
  ownerId   String        @id @map("owner_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  owner     UserProfile   @relation(fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ai_owner_allowance_owner_fkey")
  days      AiBudgetDay[]
  runs      AiRun[]

  @@map("ai_owner_allowance")
  @@schema("app")
}

model AiBudgetDay {
  ownerId      String           @map("owner_id") @db.Uuid
  day          DateTime         @db.Date
  reservedRuns Int              @default(0) @map("reserved_runs")
  consumedRuns Int              @default(0) @map("consumed_runs")
  allowance    AiOwnerAllowance @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict, onUpdate: NoAction, map: "ai_budget_day_owner_fkey")
  runs         AiRun[]

  @@id([ownerId, day])
  @@map("ai_budget_day")
  @@schema("app")
}

model AiRun {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId                String               @map("project_id") @db.Uuid
  draftId                  String               @map("draft_id") @db.Uuid
  actorId                  String               @map("actor_id") @db.Uuid
  ownerId                  String               @map("owner_id") @db.Uuid
  admissionDay             DateTime             @map("admission_day") @db.Date
  promptSourceVersionId    String               @map("prompt_source_version_id") @db.Uuid
  taskType                 AiTaskKind           @map("task_type")
  flowId                   String?              @map("flow_id") @db.Uuid
  model                    String               @db.Text
  executionBinding         String               @map("execution_binding") @db.Text
  capture                  Json?
  captureHash              String               @map("capture_hash") @db.Char(64)
  expectedDocumentRevision Int                  @map("expected_document_revision")
  parentSnapshotId         String?              @map("parent_snapshot_id") @db.Uuid
  state                    AiRunState           @default(QUEUED)
  disposition              AiResultDisposition?
  result                   Json?
  resultHash               String?              @map("result_hash") @db.Char(64)
  diff                     Json?
  failureCode              String?              @map("failure_code") @db.Text
  deadlineAt               DateTime             @map("deadline_at") @db.Timestamptz(6)
  dispatchState            AiDispatchState      @default(PENDING) @map("dispatch_state")
  dispatchId               String               @default(dbgenerated("gen_random_uuid()")) @map("dispatch_id") @db.Uuid
  taskId                   String?              @map("task_id") @db.Text
  dispatchLeaseUntil       DateTime?            @map("dispatch_lease_until") @db.Timestamptz(6)
  nextDispatchAt           DateTime?            @map("next_dispatch_at") @db.Timestamptz(6)
  currentAttemptId         String?              @map("current_attempt_id") @db.Uuid
  budgetState              AiBudgetState        @default(RESERVED) @map("budget_state")
  cancelRequestedAt        DateTime?            @map("cancel_requested_at") @db.Timestamptz(6)
  terminalAt               DateTime?            @map("terminal_at") @db.Timestamptz(6)
  lastEventSequence        BigInt               @default(0) @map("last_event_sequence") @db.BigInt
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  project                  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_run_project_fkey")
  draft                    ScopeDraft           @relation(fields: [projectId, draftId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction, map: "ai_run_project_draft_fkey")
  actor                    UserProfile          @relation("ai_run_actor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ai_run_actor_fkey")
  allowance                AiOwnerAllowance     @relation(fields: [ownerId], references: [ownerId], onDelete: Restrict, onUpdate: NoAction, map: "ai_run_owner_allowance_fkey")
  budgetDay                AiBudgetDay          @relation(fields: [ownerId, admissionDay], references: [ownerId, day], onDelete: Restrict, onUpdate: NoAction, map: "ai_run_budget_day_fkey")
  promptVersion            SourceVersion        @relation("ai_run_prompt_version", fields: [projectId, promptSourceVersionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction, map: "ai_run_prompt_version_fkey")
  currentAttempt           AiRunAttempt?        @relation("ai_run_current_attempt", fields: [id, currentAttemptId], references: [runId, id], onDelete: NoAction, onUpdate: NoAction, map: "ai_run_current_attempt_fkey")
  attempts                 AiRunAttempt[]       @relation("ai_run_attempts")
  applications             AiSuggestionApplication[]

  @@unique([projectId, id], map: "ai_run_project_id_key")
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)], map: "ai_run_project_history_idx")
  @@index([actorId], map: "ai_run_actor_idx")
  @@index([projectId, promptSourceVersionId], map: "ai_run_prompt_version_idx")
  @@map("ai_run")
  @@schema("app")
}

model AiSuggestionApplication {
  id String @id @db.Uuid
  projectId String @map("project_id") @db.Uuid
  runId String @unique(map: "ai_application_run_key") @map("run_id") @db.Uuid
  draftId String @map("draft_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  promptSourceVersionId String @map("prompt_source_version_id") @db.Uuid
  resultHash String @map("result_hash") @db.Char(64)
  selectedOperations Json @map("selected_operations")
  actualOperations Json @map("actual_operations")
  idMap Json @map("id_map")
  createdIdMap Json @map("created_id_map")
  evidence Json
  sourceVersionIds String[] @map("source_version_ids") @db.Uuid
  beforeDocumentRevision Int @map("before_document_revision")
  afterDocumentRevision Int @map("after_document_revision")
  beforeLayoutRevision Int @map("before_layout_revision")
  afterLayoutRevision Int @map("after_layout_revision")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_application_project_fkey")
  run AiRun @relation(fields: [projectId, runId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction, map: "ai_application_run_fkey")
  draft ScopeDraft @relation(fields: [projectId, draftId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction, map: "ai_application_draft_fkey")
  actor UserProfile @relation(fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ai_application_actor_fkey")
  promptVersion SourceVersion @relation(fields: [projectId, promptSourceVersionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction, map: "ai_application_prompt_fkey")
  sources AiApplicationSource[]

  @@unique([projectId, id], map: "ai_application_project_id_key")
  @@map("ai_suggestion_application")
  @@schema("app")
}

model AiApplicationSource {
  projectId String @map("project_id") @db.Uuid
  applicationId String @map("application_id") @db.Uuid
  sourceVersionId String @map("source_version_id") @db.Uuid
  application AiSuggestionApplication @relation(fields: [projectId, applicationId], references: [projectId, id], onDelete: Cascade, onUpdate: NoAction, map: "ai_application_source_application_fkey")
  sourceVersion SourceVersion @relation(fields: [projectId, sourceVersionId], references: [projectId, id], onDelete: NoAction, onUpdate: NoAction, map: "ai_application_source_version_fkey")

  @@id([applicationId, sourceVersionId])
  @@map("ai_application_source")
  @@schema("app")
}

model AiRunAttempt {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId              String            @map("run_id") @db.Uuid
  attemptNumber      Int               @map("attempt_number")
  token              String            @unique(map: "ai_run_attempt_token_key") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startedAt          DateTime          @default(now()) @map("started_at") @db.Timestamptz(6)
  deadlineAt         DateTime          @map("deadline_at") @db.Timestamptz(6)
  callMayHaveStarted Boolean           @default(false) @map("call_may_have_started")
  outcome            AiAttemptOutcome?
  settledAt          DateTime?         @map("settled_at") @db.Timestamptz(6)
  inputTokens        Int?              @map("input_tokens")
  outputTokens       Int?              @map("output_tokens")
  providerRequestId  String?           @map("provider_request_id") @db.Text
  run                AiRun             @relation("ai_run_attempts", fields: [runId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "ai_run_attempt_run_fkey")
  currentFor         AiRun[]           @relation("ai_run_current_attempt")

  @@unique([runId, attemptNumber], map: "ai_run_attempt_run_number_key")
  @@unique([runId, id], map: "ai_run_attempt_run_id_key")
  @@map("ai_run_attempt")
  @@schema("app")
}

model RateLimitBucket {
  subjectHash String   @map("subject_hash") @db.Text
  action      String   @db.Text
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  @@id([subjectHash, action, windowStart])
  @@index([expiresAt], map: "rate_limit_bucket_expires_at_idx")
  @@map("rate_limit_bucket")
  @@schema("app")
}

model AuditEvent {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId     String       @map("project_id") @db.Uuid
  sequence      BigInt       @db.BigInt
  actorId       String?      @map("actor_id") @db.Uuid
  serviceAction String?      @map("service_action") @db.Text
  action        String       @db.Text
  entityRefs    Json         @map("entity_refs")
  metadata      Json
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor         UserProfile? @relation("audit_actor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([projectId, sequence])
  @@index([projectId, createdAt, id])
  @@map("audit_event")
  @@schema("app")
}
