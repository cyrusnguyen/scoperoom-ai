# ScopeRoom Stage 01 environment template.
# Copy to .env.local and fill only the values needed for the command you run.
# .env.local is ignored by Git. Never put real credentials in this example.
# NEXT_PUBLIC_* values are browser-visible; keep secrets in unprefixed names.

# App shell (used now)
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100

# Local foundation database (needed for db:bootstrap, db:migrate,
# db:guard, db:reset and test:integration; not needed for the shell).
# Use a fresh, empty local Supabase project for initial bootstrap.
# Keep one UUID per database environment; do not change it after binding.
SCOPEROOM_ENVIRONMENT_ID=
SCOPEROOM_BOOTSTRAP_DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_URL=
WORKER_DATABASE_URL=
SCOPEROOM_MIGRATOR_PASSWORD=
SCOPEROOM_WEB_RUNTIME_PASSWORD=
SCOPEROOM_WORKER_RUNTIME_PASSWORD=
# Direct URL: postgresql://postgres:<password>@127.0.0.1:54322/postgres
# Migration URL: postgresql://app_migrator_runtime:<password>@127.0.0.1:54322/postgres?schema=app
# Pooled URLs use port 54329 and usernames app_web_runtime.<pooler-tenant>
# and app_worker_runtime.<pooler-tenant>. Get the tenant from your local stack.
# Passwords above provision the corresponding restricted login roles.

# Optional local tooling overrides. Leave unset for normal use.
# SCOPEROOM_CURRENT_ENVIRONMENT_ID=   # only for a guarded db:reset
# SCOPEROOM_SUPABASE_CONFIG=           # alternate local config.toml
# SCOPEROOM_DOCKER_BIN=                # Docker executable path

# Future Supabase Auth/client work; no Stage 01 consumer.
# The publishable key is public. The secret key must stay server-only.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=

# Future AI work; no Stage 01 consumer.
# GOOGLE_GENERATIVE_AI_API_KEY=