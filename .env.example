# ScopeRoom access checkpoint environment template.
# Copy to .env.local and fill only the values needed for the command you run.
# .env.local is ignored by Git. Never put real credentials in this example.
# NEXT_PUBLIC_* values are browser-visible; keep secrets in unprefixed names.

# App shell
APP_ENV=development
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3100

# Local foundation database (needed for db:bootstrap, db:migrate,
# db:guard, db:reset and test:integration; not needed for the shell).
# Use a fresh, empty local Supabase project for initial bootstrap.
# Keep one UUID per database environment; do not change it after binding.
SCOPEROOM_ENVIRONMENT_ID=
SCOPEROOM_BOOTSTRAP_DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_URL=
WORKER_DATABASE_URL=
SCOPEROOM_MIGRATOR_PASSWORD=
SCOPEROOM_WEB_RUNTIME_PASSWORD=
SCOPEROOM_WORKER_RUNTIME_PASSWORD=
# Direct URL: postgresql://postgres:<password>@127.0.0.1:54322/postgres
# Migration URL: postgresql://app_migrator_runtime:<password>@127.0.0.1:54322/postgres?schema=app
# Pooled URLs use port 54329 and usernames app_web_runtime.<pooler-tenant>
# and app_worker_runtime.<pooler-tenant>. Get the tenant from your local stack.
# Passwords above provision the corresponding restricted login roles.

# Optional local tooling overrides. Leave unset for normal use.
# SCOPEROOM_CURRENT_ENVIRONMENT_ID=   # only for a guarded db:reset
# SCOPEROOM_SUPABASE_CONFIG=           # alternate local config.toml
# SCOPEROOM_DOCKER_BIN=                # Docker executable path

# Hosted database tooling (operator only; see docs/hosted-pilot.md). Leave unset for local work.
# SCOPEROOM_DB_TARGET=hosted
# SCOPEROOM_SUPABASE_PROJECT_REF=
# Hosted runtime only (Vercel web and worker projects): the Supabase root CA PEM, so pooled connections verify the server. Public, not a secret.
# SCOPEROOM_DATABASE_CA_PEM=

# Supabase Auth: required for sign-in and protected workspace access.
# The publishable key is public. Never place a secret key in NEXT_PUBLIC variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Scoped Realtime credential (server-only; see docs/realtime-setup.md). The key is project-wide signing authority: never NEXT_PUBLIC.
# Local: ALG=HS256 with the disposable stack's JWT secret (`supabase status`). Hosted: ALG=ES256, KEY=PKCS8 PEM of an imported key, KID=its key id.
SCOPEROOM_REALTIME_SIGNING_ALG=
SCOPEROOM_REALTIME_SIGNING_KEY=
SCOPEROOM_REALTIME_SIGNING_KID=

# AI runs (see docs/ai-setup.md). Blank means absent: automated suites and the e2e server blank the provider secrets and use fakes.
# Server-side admission: the model id (a bare id, no spaces, line breaks or quotes) and the opaque worker execution binding captured
# on each run (the release SHA, at most 128 characters, a Production variable on both Vercel projects). No credential belongs in either.
AI_MODEL=
AI_EXECUTION_BINDING=
# Default-plan AI limits for every account without an active override (web only). Blank keeps 5 total and 30 per day;
# any other value must be a non-negative integer (0 blocks AI). Leave blank for automated suites.
AI_TOTAL_RUN_LIMIT=
AI_DAILY_RUN_LIMIT=
# Provider secrets, server and worker only, never NEXT_PUBLIC. Local development and every test suite run with these blank.
# INNGEST_EVENT_KEY: web (sends run events) and worker (the repair endpoint re-sends); absent means runs stay PENDING and time out with a refund.
INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY: worker only, verifies Inngest's calls to /api/inngest.
INNGEST_SIGNING_KEY=
# SCOPEROOM_SERVICE=worker: set on the worker Vercel project only; it then serves only /api/inngest, the two /api/internal/worker maintenance endpoints (plus /_next/static and /_next/image) and 404s every other path.
# SCOPEROOM_SERVICE=worker
# SCOPEROOM_WORKER_SECRET: worker project, and the Supabase Vault copy that scripts/db/schedule.mjs writes; at least 32 random characters; never on the web project.
# SCOPEROOM_WORKER_SECRET=
# SCOPEROOM_WORKER_URL: operator .env.hosted.local only; the worker's bare https origin, read by scripts/db/schedule.mjs.
# SCOPEROOM_WORKER_URL=
# GOOGLE_GENERATIVE_AI_API_KEY: worker only, for the model call.
GOOGLE_GENERATIVE_AI_API_KEY=

RESEND_API_KEY=